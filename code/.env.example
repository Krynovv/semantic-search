# Корень для данных, кэша переводов и моделей.
# По умолчанию <корень кода>/var, то есть kursovaya-tex/code/var.
# Пример для Colab: SEMSEARCH_HOME=/content/drive/MyDrive/semsearch
SEMSEARCH_HOME=

# Токен HuggingFace (нужен только для приватных моделей и при высоком лимите запросов).
# Никогда не коммитить .env — в репозитории лежит только .env.example.
HF_TOKEN=
